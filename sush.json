{
  "openapi": "3.0.3",
  "info": {
    "title": "Oxide Support Shell",
    "version": "0.1.0"
  },
  "paths": {
    "/certs": {
      "put": {
        "summary": "Import a certificate, verify its signature, and return a key ID for it.",
        "operationId": "import_cert",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "description": "Authorization to access some resource, such as a signature.\n\nSee: <https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Authorization>",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "title": "Array_of_uint8",
                "type": "array",
                "items": {
                  "type": "integer",
                  "format": "uint8",
                  "minimum": 0
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KeyId"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/certs/{key_id}": {
      "get": {
        "summary": "Get the certificate chain that validates a key.",
        "description": "Certificates are in root-to-leaf order, PEM encoded and newline separated.",
        "operationId": "cert_chain",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "description": "Authorization to access some resource, such as a signature.\n\nSee: <https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Authorization>",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "key_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/KeyId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "title": "String",
                  "type": "string"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/iam": {
      "get": {
        "summary": "List cached identities.",
        "description": "May include duplicate identities with different nonces.",
        "operationId": "identities",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "description": "Authorization to access some resource, such as a signature.\n\nSee: <https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Authorization>",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "title": "Array_of_Identity",
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Identity"
                  }
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "summary": "Prove and register identity.",
        "operationId": "iam",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "description": "Authorization to access some resource, such as a signature.\n\nSee: <https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Authorization>",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "nullable": true,
                "title": "Nullable_String",
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Identity"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/jobs": {
      "get": {
        "summary": "List previous jobs sorted by start time, most recent first.",
        "operationId": "job_history",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "description": "Authorization to access some resource, such as a signature.\n\nSee: <https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Authorization>",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "description": "limit=0 means all jobs",
            "schema": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "title": "Array_of_Map_of_JobStatus",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/components/schemas/JobStatus"
                    }
                  }
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/jobs/{job_id}/attach/{target}": {
      "get": {
        "summary": "Attach to an interactive job.",
        "operationId": "job_attach",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "description": "Authorization to access some resource, such as a signature.\n\nSee: <https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Authorization>",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "job_id",
            "description": "Which job to attach to.",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/JobId"
            }
          },
          {
            "in": "path",
            "name": "target",
            "description": "To be used by Nexus for routing.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "description": "",
            "content": {
              "*/*": {
                "schema": {}
              }
            }
          }
        },
        "x-dropshot-websocket": {}
      }
    },
    "/jobs/{job_id}/output/{target}/{stream}": {
      "get": {
        "summary": "Get (a subset of) the standard output or standard error of a job.",
        "operationId": "job_output",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "description": "Authorization to access the range.\n\nSee: <https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Authorization>",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "range",
            "description": "A request to access a portion of the resource, such as `bytes=0-499`\n\nSee: <https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Range>",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/JobId"
            }
          },
          {
            "in": "path",
            "name": "target",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "stream",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/JobOutputStream"
            }
          }
        ],
        "responses": {
          "default": {
            "description": "",
            "content": {
              "*/*": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}/start": {
      "post": {
        "summary": "Start an authorized job.",
        "operationId": "job_start",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "description": "Authorization to access some resource, such as a signature.\n\nSee: <https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Authorization>",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/JobId"
            }
          },
          {
            "in": "query",
            "name": "term",
            "description": "Terminal type for interactive jobs.",
            "schema": {
              "nullable": true,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "rows",
            "description": "Terminal window height for interactive jobs.",
            "schema": {
              "nullable": true,
              "type": "integer",
              "format": "uint16",
              "minimum": 0
            }
          },
          {
            "in": "query",
            "name": "cols",
            "description": "Terminal window width for interactive jobs.",
            "schema": {
              "nullable": true,
              "type": "integer",
              "format": "uint16",
              "minimum": 0
            }
          },
          {
            "in": "query",
            "name": "wait",
            "description": "Wait for the job to start or stop.",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/JobWait"
            }
          },
          {
            "in": "query",
            "name": "max_cpu",
            "description": "Maximum CPU use in seconds.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          {
            "in": "query",
            "name": "max_mem",
            "description": "Maximum size of address space in bytes.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          {
            "in": "query",
            "name": "max_fsize",
            "description": "Maximum file size in bytes.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Signed_for_JobStartRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "resource updated"
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/jobs/{job_id}/status": {
      "get": {
        "summary": "Get the status of a job across the rack.",
        "operationId": "job_status",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "description": "Authorization to access some resource, such as a signature.\n\nSee: <https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Authorization>",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/JobId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "title": "Map_of_JobStatus",
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/components/schemas/JobStatus"
                  }
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/jobs/{job_id}/stop": {
      "post": {
        "summary": "Stop a (running) job.",
        "operationId": "job_stop",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "description": "Authorization to access some resource, such as a signature.\n\nSee: <https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Authorization>",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/JobId"
            }
          },
          {
            "in": "query",
            "name": "wait",
            "description": "Wait for the job process to end.",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/JobWait"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "resource updated"
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/sessions": {
      "get": {
        "summary": "Get the current session from this server's point of view.",
        "operationId": "session",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "description": "Authorization to access some resource, such as a signature.\n\nSee: <https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Authorization>",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/sessions/{session_id}/start": {
      "post": {
        "summary": "Start a new support session.",
        "description": "There may only be one session active on the rack at a time. If a session is already running when this request is made, the old session is stopped.",
        "operationId": "session_start",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "description": "Authorization to access some resource, such as a signature.\n\nSee: <https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Authorization>",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/SessionId"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "resource updated"
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/sessions/{session_id}/stop": {
      "post": {
        "summary": "End a support session.",
        "operationId": "session_stop",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "description": "Authorization to access some resource, such as a signature.\n\nSee: <https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Authorization>",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/SessionId"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "resource updated"
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/target": {
      "get": {
        "summary": "Get the baseboard ID of the sled handling this request.",
        "operationId": "target",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "description": "Authorization to access some resource, such as a signature.\n\nSee: <https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Authorization>",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseboardId"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "KeyId": {
        "description": "SHA-256 of a certificate subject or an identity public key, encoded as a pseudorandom code phrase for storage & transport.",
        "type": "string"
      },
      "Error": {
        "description": "Error information from a response.",
        "type": "object",
        "properties": {
          "error_code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "message",
          "request_id"
        ]
      },
      "Identity": {
        "description": "An authenticated identity.",
        "type": "object",
        "properties": {
          "key_id": {
            "$ref": "#/components/schemas/KeyId"
          },
          "public_key": {
            "type": "string"
          },
          "nonce": {
            "$ref": "#/components/schemas/Nonce"
          },
          "time_authenticated": {
            "type": "string",
            "format": "date-time"
          },
          "time_revoked": {
            "nullable": true,
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "key_id",
          "nonce",
          "public_key",
          "time_authenticated"
        ]
      },
      "Nonce": {
        "description": "A unique random string. Authentication credentials have two of these: one generated by the server, and one by the client. This structure is agnostic to the syntax of the string.",
        "type": "string"
      },
      "JobStatus": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "Started": {
                "type": "object",
                "properties": {
                  "job_id": {
                    "$ref": "#/components/schemas/JobId"
                  },
                  "time_started": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "job_id",
                  "time_started"
                ]
              }
            },
            "required": [
              "Started"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "Stopped": {
                "type": "object",
                "properties": {
                  "job_id": {
                    "$ref": "#/components/schemas/JobId"
                  },
                  "time_started": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "time_stopped": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "result": {
                    "$ref": "#/components/schemas/Result_of_int32_or_ProcessError"
                  },
                  "output": {
                    "$ref": "#/components/schemas/JobOutputState"
                  }
                },
                "required": [
                  "job_id",
                  "output",
                  "result",
                  "time_started",
                  "time_stopped"
                ]
              }
            },
            "required": [
              "Stopped"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "Error": {
                "type": "object",
                "properties": {
                  "job_id": {
                    "$ref": "#/components/schemas/JobId"
                  },
                  "time_error": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "error": {
                    "$ref": "#/components/schemas/ProcessError"
                  }
                },
                "required": [
                  "error",
                  "job_id",
                  "time_error"
                ]
              }
            },
            "required": [
              "Error"
            ],
            "additionalProperties": false
          }
        ]
      },
      "JobId": {
        "description": "A globally unique identifier for a job within a session.",
        "type": "string"
      },
      "Result_of_int32_or_ProcessError": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "Ok": {
                "type": "integer",
                "format": "int32"
              }
            },
            "required": [
              "Ok"
            ]
          },
          {
            "type": "object",
            "properties": {
              "Err": {
                "$ref": "#/components/schemas/ProcessError"
              }
            },
            "required": [
              "Err"
            ]
          }
        ]
      },
      "ProcessError": {
        "description": "What went wrong running a job's process or interactive session.\n\nWe currently squash inner errors into strings to avoid excessive derivation requirements, but may come to regret that decision.",
        "oneOf": [
          {
            "type": "string",
            "enum": [
              "Unknown"
            ]
          },
          {
            "type": "object",
            "properties": {
              "Killed": {
                "type": "integer",
                "format": "int32"
              }
            },
            "required": [
              "Killed"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "Interactive": {
                "type": "string"
              }
            },
            "required": [
              "Interactive"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "Io": {
                "type": "object",
                "properties": {
                  "what": {
                    "type": "string"
                  },
                  "error": {
                    "type": "string"
                  }
                },
                "required": [
                  "error",
                  "what"
                ]
              }
            },
            "required": [
              "Io"
            ],
            "additionalProperties": false
          }
        ]
      },
      "JobOutputState": {
        "type": "object",
        "properties": {
          "stdout_len": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "stderr_len": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "stdout_hash": {
            "$ref": "#/components/schemas/JobOutputHash"
          },
          "stderr_hash": {
            "$ref": "#/components/schemas/JobOutputHash"
          }
        },
        "required": [
          "stderr_hash",
          "stderr_len",
          "stdout_hash",
          "stdout_len"
        ]
      },
      "JobOutputHash": {
        "description": "BLAKE3 hash of job output, used as a checksum.",
        "type": "string",
        "format": "hex encoded hash (32 bytes)"
      },
      "Signed_for_JobStartRequest": {
        "description": "A signed envelope around some data.",
        "type": "object",
        "properties": {
          "payload": {
            "$ref": "#/components/schemas/JobStartRequest"
          },
          "key_id": {
            "$ref": "#/components/schemas/KeyId"
          },
          "signature": {
            "$ref": "#/components/schemas/EncodedSignature"
          }
        },
        "required": [
          "key_id",
          "payload",
          "signature"
        ]
      },
      "JobStartRequest": {
        "description": "A request to run the given `command` as `job_id`.",
        "type": "object",
        "properties": {
          "job_id": {
            "$ref": "#/components/schemas/JobId"
          },
          "command": {
            "type": "string"
          },
          "interactive": {
            "type": "boolean"
          }
        },
        "required": [
          "command",
          "job_id"
        ]
      },
      "EncodedSignature": {
        "description": "Code phrase encoded signature.\n\nThe decoded phrases `r` and `s` together comprise a signature _(r, s)_ over a 256 bit elliptic curve.\n\nThe `flags` and `counter` parameters are for the [`SK-*` family of SSH public keys](https://cvsweb.openbsd.org/src/usr.bin/ssh/PROTOCOL.u2f?annotate=HEAD). They should be set to 0 for other key types.",
        "type": "object",
        "properties": {
          "r": {
            "type": "string"
          },
          "s": {
            "type": "string"
          },
          "flags": {
            "type": "integer",
            "format": "uint8",
            "minimum": 0
          },
          "counter": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "required": [
          "r",
          "s"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "session_id": {
            "$ref": "#/components/schemas/SessionId"
          },
          "last_job": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/Signed_for_JobStartRequest"
              }
            ]
          }
        },
        "required": [
          "session_id"
        ]
      },
      "SessionId": {
        "description": "A globally unique identifier for a session.",
        "type": "string"
      },
      "BaseboardId": {
        "description": "A representation of a Baseboard ID as used in the inventory subsystem.\n\nThis type is essentially the same as a `Baseboard` except it doesn't have a revision or HW type (Gimlet, PC, Unknown).",
        "type": "object",
        "properties": {
          "part_number": {
            "description": "Oxide Part Number",
            "type": "string"
          },
          "serial_number": {
            "description": "Serial number (unique for a given part number)",
            "type": "string"
          }
        },
        "required": [
          "part_number",
          "serial_number"
        ]
      },
      "JobOutputStream": {
        "description": "Either the standard output or standard error of a job.",
        "type": "string",
        "enum": [
          "stdout",
          "stderr"
        ]
      },
      "JobWait": {
        "description": "Whether and until what state is reached to wait for a job start/stop request.",
        "type": "string",
        "enum": [
          "none",
          "start",
          "stop"
        ]
      }
    },
    "responses": {
      "Error": {
        "description": "Error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
