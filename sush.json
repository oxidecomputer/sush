{
  "openapi": "3.0.3",
  "info": {
    "title": "Oxide Support Shell",
    "version": "0.1.0"
  },
  "paths": {
    "/certs": {
      "put": {
        "summary": "Import a certificate, verify its signature, and return a key ID for it.",
        "operationId": "import_cert",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "title": "Array_of_uint8",
                "type": "array",
                "items": {
                  "type": "integer",
                  "format": "uint8",
                  "minimum": 0
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KeyId"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/certs/{key_id}": {
      "get": {
        "summary": "Get the certificate chain that validates a key.",
        "description": "Certificates are in root-to-leaf order, PEM encoded and newline separated.",
        "operationId": "cert_chain",
        "parameters": [
          {
            "in": "path",
            "name": "key_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/KeyId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "title": "String",
                  "type": "string"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/history": {
      "get": {
        "summary": "List previous jobs (paginated).",
        "operationId": "history",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "description": "Maximum number of items returned by a single call",
            "schema": {
              "nullable": true,
              "type": "integer",
              "format": "uint32",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "page_token",
            "description": "Token returned by previous call to retrieve the subsequent page",
            "schema": {
              "nullable": true,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatusResultsPage"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        },
        "x-dropshot-pagination": {
          "required": []
        }
      }
    },
    "/jobs/{job_id}/abort": {
      "get": {
        "summary": "Abort a started job.",
        "operationId": "job_abort",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/JobId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "title": "Null",
                  "type": "string",
                  "enum": [
                    null
                  ]
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/jobs/{job_id}/output/{stream}": {
      "get": {
        "summary": "Get (a subset of) the standard output or standard error of a job.",
        "operationId": "job_output",
        "parameters": [
          {
            "in": "header",
            "name": "range",
            "description": "A request to access a portion of the resource, such as `bytes=0-499`\n\nSee: <https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Range>",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/JobId"
            }
          },
          {
            "in": "path",
            "name": "stream",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/JobOutputStream"
            }
          }
        ],
        "responses": {
          "default": {
            "description": "",
            "content": {
              "*/*": {
                "schema": {}
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Truncate the standard output or standard error of a job.",
        "description": "Returns its new length.",
        "operationId": "job_output_delete",
        "parameters": [
          {
            "in": "header",
            "name": "range",
            "description": "A request to access a portion of the resource, such as `bytes=0-499`\n\nSee: <https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Range>",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/JobId"
            }
          },
          {
            "in": "path",
            "name": "stream",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/JobOutputStream"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "title": "uint64",
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/jobs/{job_id}/session": {
      "get": {
        "summary": "Start a new interactive job session.",
        "operationId": "job_session",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/JobId"
            }
          }
        ],
        "responses": {
          "default": {
            "description": "",
            "content": {
              "*/*": {
                "schema": {}
              }
            }
          }
        },
        "x-dropshot-websocket": {}
      }
    },
    "/jobs/{job_id}/start": {
      "post": {
        "summary": "Start an authorized job.",
        "operationId": "job_start",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/JobId"
            }
          },
          {
            "in": "query",
            "name": "wait",
            "description": "Keep the request open until the job ends.",
            "required": true,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "max_cpu",
            "description": "Maximum CPU use in seconds.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          {
            "in": "query",
            "name": "max_mem",
            "description": "Maximum size of address space in bytes.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          {
            "in": "query",
            "name": "max_fsize",
            "description": "Maximum file size in bytes.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Signed_for_JobStartRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatus"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/jobs/{job_id}/status": {
      "get": {
        "summary": "Get the status of a started job.",
        "operationId": "job_status",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/JobId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatus"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/reserved": {
      "get": {
        "summary": "Map of job ID → time reserved for unused job slots.",
        "operationId": "get_reserved",
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "title": "Map_of_DateTime",
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "summary": "Reserve some job slots with fresh, globally unique IDs.",
        "operationId": "reserve_jobs",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "title": "uint8",
                "type": "integer",
                "format": "uint8",
                "minimum": 0
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobsReserved"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "delete": {
        "summary": "Revoke a set of reserved but unused job slots.",
        "description": "Has no effect on jobs already started or finished, so it is safe to call this with a list of IDs where some have been used. If called with an empty list, revokes all reserved but unused jobs. Returns the list of jobs actually revoked.",
        "operationId": "revoke_reserved",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "title": "Array_of_JobId",
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/JobId"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "title": "Array_of_JobId",
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JobId"
                  }
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "KeyId": {
        "description": "SHA-256 of a certificate subject, encoded as a pseudo-random code phrase for storage and transport.",
        "type": "string"
      },
      "Error": {
        "description": "Error information from a response.",
        "type": "object",
        "properties": {
          "error_code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "message",
          "request_id"
        ]
      },
      "JobStatusResultsPage": {
        "description": "A single page of results",
        "type": "object",
        "properties": {
          "next_page": {
            "nullable": true,
            "description": "token used to fetch the next page of results (if any)",
            "type": "string"
          },
          "items": {
            "description": "list of items on this page of results",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobStatus"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "JobStatus": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "Reserved": {
                "type": "object",
                "properties": {
                  "job_id": {
                    "$ref": "#/components/schemas/JobId"
                  },
                  "time_reserved": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "job_id",
                  "time_reserved"
                ]
              }
            },
            "required": [
              "Reserved"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "Started": {
                "type": "object",
                "properties": {
                  "job": {
                    "$ref": "#/components/schemas/Verified_for_JobStartRequest"
                  },
                  "time_reserved": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "time_started": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "stdout_len": {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                  },
                  "stderr_len": {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                  }
                },
                "required": [
                  "job",
                  "stderr_len",
                  "stdout_len",
                  "time_reserved",
                  "time_started"
                ]
              }
            },
            "required": [
              "Started"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "Ended": {
                "type": "object",
                "properties": {
                  "job": {
                    "$ref": "#/components/schemas/Verified_for_JobStartRequest"
                  },
                  "time_reserved": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "time_started": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "time_ended": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "status": {
                    "nullable": true,
                    "type": "integer",
                    "format": "int32"
                  },
                  "stdout_len": {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                  },
                  "stderr_len": {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                  },
                  "stdout_hash": {
                    "$ref": "#/components/schemas/JobOutputHash"
                  },
                  "stderr_hash": {
                    "$ref": "#/components/schemas/JobOutputHash"
                  }
                },
                "required": [
                  "job",
                  "stderr_hash",
                  "stderr_len",
                  "stdout_hash",
                  "stdout_len",
                  "time_ended",
                  "time_reserved",
                  "time_started"
                ]
              }
            },
            "required": [
              "Ended"
            ],
            "additionalProperties": false
          }
        ]
      },
      "JobId": {
        "type": "string"
      },
      "Verified_for_JobStartRequest": {
        "description": "An envelope whose signature has been verified.",
        "type": "object",
        "properties": {
          "signed": {
            "$ref": "#/components/schemas/Signed_for_JobStartRequest"
          },
          "verified_by": {
            "$ref": "#/components/schemas/KeyId"
          }
        },
        "required": [
          "signed",
          "verified_by"
        ]
      },
      "Signed_for_JobStartRequest": {
        "description": "A signed envelope around some data.",
        "type": "object",
        "properties": {
          "payload": {
            "$ref": "#/components/schemas/JobStartRequest"
          },
          "key_id": {
            "$ref": "#/components/schemas/KeyId"
          },
          "signature": {
            "$ref": "#/components/schemas/EncodedSignature"
          }
        },
        "required": [
          "key_id",
          "payload",
          "signature"
        ]
      },
      "JobStartRequest": {
        "description": "A request to run the given `command` in the slot reserved by `job_id`.",
        "type": "object",
        "properties": {
          "job_id": {
            "$ref": "#/components/schemas/JobId"
          },
          "command": {
            "type": "string"
          },
          "interactive": {
            "type": "boolean"
          }
        },
        "required": [
          "command",
          "job_id"
        ]
      },
      "EncodedSignature": {
        "description": "Code phrase encoded signature.",
        "type": "object",
        "properties": {
          "r": {
            "type": "string"
          },
          "s": {
            "type": "string"
          }
        },
        "required": [
          "r",
          "s"
        ]
      },
      "JobOutputHash": {
        "description": "BLAKE3 hash of job output, used as a checksum.",
        "type": "string",
        "format": "hex encoded hash (32 bytes)"
      },
      "JobsReserved": {
        "description": "The response to a job reservation request.",
        "type": "object",
        "properties": {
          "job_ids": {
            "description": "Fresh, globally unique job IDs.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobId"
            }
          },
          "time_reserved": {
            "description": "The server's idea of the time at which the job IDs were reserved.",
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "job_ids",
          "time_reserved"
        ]
      },
      "JobOutputStream": {
        "description": "Either the standard output or standard error of a job.",
        "type": "string",
        "enum": [
          "stdout",
          "stderr"
        ]
      }
    },
    "responses": {
      "Error": {
        "description": "Error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
